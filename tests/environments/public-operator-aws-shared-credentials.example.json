{
  "schema_version": 1,
  "name": "public-operator-aws-shared-credentials-example",
  "mode": "live",
  "provider": "aws",
  "public_configuration": true,
  "resource": {
    "alias": "preexisting-public-aws",
    "settings": {
      "region": "us-east-1",
      "bucket": "replace-preexisting-enkv-public-bucket",
      "recovery_mode": "enabled",
      "account": "123456789012",
      "key_id": "arn:aws:kms:us-east-1:123456789012:key/11111111-1111-1111-1111-111111111111",
      "authority_kek_id": "arn:aws:kms:us-east-1:123456789012:key/22222222-2222-2222-2222-222222222222",
      "reader_kek_id": "arn:aws:kms:us-east-1:123456789012:key/33333333-3333-3333-3333-333333333333",
      "recovery_key_id": "arn:aws:kms:us-east-1:123456789012:key/44444444-4444-4444-4444-444444444444",
      "recovery_kek_id": "arn:aws:kms:us-east-1:123456789012:key/55555555-5555-5555-5555-555555555555",
      "normal_successor_key_id": "arn:aws:kms:us-east-1:123456789012:key/66666666-6666-6666-6666-666666666666",
      "authority_successor_1_kek_id": "arn:aws:kms:us-east-1:123456789012:key/88888888-8888-8888-8888-888888888888"
    }
  },
  "participants": {
    "operator": {
      "access": {
        "sdk_context": {
          "mode": "aws-shared-credentials",
          "home": "/ABSOLUTE/ISOLATED/LOGIN/operator/aws-shared-credentials",
          "profile": "enkv-operator"
        }
      }
    }
  },
  "role_bindings": {
    "authority": "operator",
    "apply": "operator",
    "reader": "operator",
    "consumer": "operator",
    "cleanup": "operator"
  }
}
