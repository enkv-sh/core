{
  "schema_version": 1,
  "name": "public-operator-gcp-user-adc-example",
  "mode": "live",
  "provider": "gcp",
  "public_configuration": true,
  "resource": {
    "alias": "preexisting-public-gcp",
    "settings": {
      "region": "australia-southeast1",
      "bucket": "replace-preexisting-enkv-public-bucket",
      "recovery_mode": "enabled",
      "project": "replace-project",
      "project_number": "123456789",
      "quota_project": "replace-quota-project",
      "key_id": "projects/replace-project/locations/australia-southeast1/keyRings/preexisting/cryptoKeys/normal-signing/cryptoKeyVersions/1",
      "authority_kek_id": "projects/replace-project/locations/australia-southeast1/keyRings/preexisting/cryptoKeys/authority-encryption/cryptoKeyVersions/1",
      "reader_kek_id": "projects/replace-project/locations/australia-southeast1/keyRings/preexisting/cryptoKeys/recipient-encryption/cryptoKeyVersions/1",
      "recovery_key_id": "projects/replace-project/locations/australia-southeast1/keyRings/preexisting/cryptoKeys/recovery-signing/cryptoKeyVersions/1",
      "recovery_kek_id": "projects/replace-project/locations/australia-southeast1/keyRings/preexisting/cryptoKeys/recovery-encryption/cryptoKeyVersions/1",
      "normal_successor_key_id": "projects/replace-project/locations/australia-southeast1/keyRings/preexisting/cryptoKeys/successor-signing/cryptoKeyVersions/1",
      "authority_successor_1_kek_id": "projects/replace-project/locations/australia-southeast1/keyRings/preexisting/cryptoKeys/authority-successor/cryptoKeyVersions/1"
    }
  },
  "participants": {
    "operator": {
      "access": {
        "sdk_context": {
          "mode": "gcp-user-adc",
          "home": "/ABSOLUTE/ISOLATED/LOGIN/operator/gcp-user-adc"
        }
      }
    }
  },
  "role_bindings": {
    "authority": "operator",
    "apply": "operator",
    "reader": "operator",
    "consumer": "operator",
    "cleanup": "operator"
  }
}
