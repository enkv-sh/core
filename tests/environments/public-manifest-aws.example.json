{
  "schema_version": 1,
  "name": "public-manifest-aws-example",
  "mode": "live",
  "provider": "aws",
  "public_configuration": true,
  "resource": {
    "alias": "preexisting-public-aws",
    "settings": {
      "region": "us-east-1",
      "bucket": "replace-preexisting-enkv-public-bucket",
      "recovery_mode": "enabled",
      "account": "123456789012",
      "key_id": "arn:aws:kms:us-east-1:123456789012:key/11111111-1111-1111-1111-111111111111",
      "authority_kek_id": "arn:aws:kms:us-east-1:123456789012:key/22222222-2222-2222-2222-222222222222",
      "reader_kek_id": "arn:aws:kms:us-east-1:123456789012:key/33333333-3333-3333-3333-333333333333",
      "recovery_key_id": "arn:aws:kms:us-east-1:123456789012:key/44444444-4444-4444-4444-444444444444",
      "recovery_kek_id": "arn:aws:kms:us-east-1:123456789012:key/55555555-5555-5555-5555-555555555555",
      "normal_successor_key_id": "arn:aws:kms:us-east-1:123456789012:key/66666666-6666-6666-6666-666666666666",
      "authority_successor_1_kek_id": "arn:aws:kms:us-east-1:123456789012:key/00000008-0008-0008-0008-000000000008",
      "reader_successor_kek_id": "arn:aws:kms:us-east-1:123456789012:key/0000000a-000a-000a-000a-00000000000a",
      "recovery_successor_key_id": "arn:aws:kms:us-east-1:123456789012:key/00000007-0007-0007-0007-000000000007",
      "recovery_successor_1_kek_id": "arn:aws:kms:us-east-1:123456789012:key/00000009-0009-0009-0009-000000000009"
    }
  },
  "participants": {
    "authority": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/ISOLATED/LOGIN/aws/authority",
          "profile": "enkv-public-authority"
        }
      }
    },
    "apply": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/ISOLATED/LOGIN/aws/apply",
          "profile": "enkv-public-apply"
        }
      }
    },
    "reader": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/ISOLATED/LOGIN/aws/reader",
          "profile": "enkv-public-reader"
        }
      }
    },
    "cleanup": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/ISOLATED/LOGIN/aws/cleanup",
          "profile": "enkv-public-cleanup"
        }
      }
    }
  },
  "role_bindings": {
    "authority": "authority",
    "apply": "apply",
    "reader": "reader",
    "cleanup": "cleanup"
  },
  "public_outputs": {
    "repository": {
      "owner": "manifest-fixture-owner",
      "repository": "manifest-fixture-repository"
    },
    "organization": {
      "owner": "manifest-fixture-organization",
      "visibility": "selected",
      "repositories": [
        101,
        202
      ]
    },
    "environment": {
      "owner": "manifest-fixture-owner",
      "repository": "manifest-fixture-repository",
      "environment": "manifest-fixture"
    }
  }
}
