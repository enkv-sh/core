{
  "schema_version": 1,
  "name": "daily-retirement-browser-login-example",
  "mode": "live",
  "provider": "aws",
  "public_configuration": true,
  "resource": {
    "alias": "daily-retirement-versioned-store",
    "settings": {
      "region": "us-east-1",
      "bucket": "enkv-123456789012-pa-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "recovery_mode": "enabled",
      "account": "123456789012",
      "key_id": "arn:aws:kms:us-east-1:123456789012:key/11111111-1111-1111-1111-111111111111",
      "authority_kek_id": "arn:aws:kms:us-east-1:123456789012:key/22222222-2222-2222-2222-222222222222",
      "reader_kek_id": "arn:aws:kms:us-east-1:123456789012:key/33333333-3333-3333-3333-333333333333",
      "recovery_key_id": "arn:aws:kms:us-east-1:123456789012:key/44444444-4444-4444-4444-444444444444",
      "recovery_kek_id": "arn:aws:kms:us-east-1:123456789012:key/55555555-5555-5555-5555-555555555555"
    }
  },
  "participants": {
    "authority": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/PRIVATE/daily-retirement/authority",
          "profile": "enkv-plugin-authority"
        }
      }
    },
    "apply": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/PRIVATE/daily-retirement/apply",
          "profile": "enkv-plugin-apply"
        }
      }
    },
    "reader": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/PRIVATE/daily-retirement/reader",
          "profile": "enkv-plugin-reader"
        }
      }
    },
    "consumer": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/PRIVATE/daily-retirement/consumer",
          "profile": "enkv-plugin-consumer"
        }
      }
    },
    "cleanup": {
      "access": {
        "sdk_context": {
          "mode": "aws-assume-role",
          "home": "/ABSOLUTE/PRIVATE/daily-retirement/cleanup",
          "profile": "enkv-plugin-cleanup"
        }
      }
    }
  },
  "role_bindings": {
    "authority": "authority",
    "apply": "apply",
    "reader": "reader",
    "consumer": "consumer",
    "cleanup": "cleanup"
  },
  "plugin_acceptance": {
    "schema": 1,
    "purpose": "stock-plugin-retirement-proof",
    "fixture_id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "provider": "aws",
    "region": "us-east-1",
    "bucket": "enkv-123456789012-pa-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "account": "123456789012",
    "daily_role_prefix": "enkv-orders-r01-public"
  },
  "public_outputs": {
    "repository": {
      "owner": "replace-owner",
      "repository": "replace-repository"
    },
    "organization": {
      "owner": "replace-organization",
      "visibility": "selected",
      "repositories": [
        101,
        202
      ]
    },
    "environment": {
      "owner": "replace-owner",
      "repository": "replace-repository",
      "environment": "replace-environment"
    }
  }
}
