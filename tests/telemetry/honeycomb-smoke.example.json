{
  "schema_version": 1,
  "resource": {
    "attributes": {
      "service.name": "enkv",
      "deployment.environment.name": "telemetry-example"
    }
  },
  "logs": {"level": "debug", "exporters": ["console", "capture", "honeycomb"]},
  "metrics": {"exporters": ["capture", "honeycomb"]},
  "traces": {"exporters": ["capture", "honeycomb"], "sample_ratio": 1},
  "exporters": {
    "capture": {"type": "otlp_file", "directory": "telemetry"},
    "honeycomb": {
      "type": "otlp_http",
      "endpoint": "https://api.honeycomb.io",
      "api_key_env": "HONEYCOMB_API_KEY"
    }
  }
}
