{
  "schema_version": 1,
  "name": "public-inspection-receipts-live",
  "description": "Explicit opt-in public inspection and receipt reads for AWS and GCP in both Recovery modes. Selection supplies no live-service evidence.",
  "steps": [
    {
      "id": "public-inspection-receipts-aws-disabled",
      "kind": "run",
      "suites": [
        "../suites/public-inspection-receipts.json"
      ],
      "environment": "../environments/public-aws-assume-role.example.json",
      "telemetry_config": "../telemetry/local.json",
      "limits": "../live/limits/public-configuration.json",
      "recovery_mode": "disabled"
    },
    {
      "id": "public-inspection-receipts-gcp-disabled",
      "kind": "run",
      "suites": [
        "../suites/public-inspection-receipts.json"
      ],
      "environment": "../environments/public-gcp-impersonated.example.json",
      "telemetry_config": "../telemetry/local.json",
      "limits": "../live/limits/public-configuration.json",
      "recovery_mode": "disabled"
    },
    {
      "id": "public-inspection-receipts-aws-enabled",
      "kind": "run",
      "suites": [
        "../suites/public-inspection-receipts.json"
      ],
      "environment": "../environments/public-aws-assume-role.example.json",
      "telemetry_config": "../telemetry/local.json",
      "limits": "../live/limits/public-configuration.json",
      "recovery_mode": "enabled"
    },
    {
      "id": "public-inspection-receipts-gcp-enabled",
      "kind": "run",
      "suites": [
        "../suites/public-inspection-receipts.json"
      ],
      "environment": "../environments/public-gcp-impersonated.example.json",
      "telemetry_config": "../telemetry/local.json",
      "limits": "../live/limits/public-configuration.json",
      "recovery_mode": "enabled"
    }
  ]
}
